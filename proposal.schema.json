{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Warp proposal",
  "description": "One proposal per call. Every dollar figure must be computed by your code from data/, never produced by a language model. See PROPOSAL_SPEC.md.",
  "type": "object",
  "required": ["call_id", "customer", "deal_summary", "lanes", "volume_tier",
               "monthly_total", "annual_total", "excluded", "assumptions",
               "open_questions"],
  "properties": {
    "call_id": {"type": "string", "description": "Matches the transcript filename stem, e.g. call_01_northwind"},
    "customer": {
      "type": "object",
      "properties": {
        "company": {"type": "string"},
        "contact": {"type": ["string", "null"]},
        "industry": {"type": ["string", "null"]}
      },
      "required": ["company"]
    },
    "deal_summary": {
      "type": "string",
      "description": "Two or three sentences a rep can read aloud. Prose, written by your model."
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["origin_metro", "origin_state", "dest_metro", "dest_state", "serviceable"],
        "properties": {
          "origin_metro": {"type": "string"},
          "origin_state": {"type": "string", "description": "Two-letter state code"},
          "dest_metro": {"type": "string"},
          "dest_state": {"type": "string"},
          "lane_id": {"type": ["string", "null"], "description": "lane_id from rate_card.csv"},
          "serviceable": {"type": "boolean"},
          "unserviceable_reason": {
            "type": ["string", "null"],
            "enum": ["lane_not_in_rate_card", "equipment_not_offered",
                     "commodity_not_accepted", "exceeds_capacity", null]
          },
          "pallets_per_shipment": {"type": ["number", "null"]},
          "weight_lb_per_pallet": {"type": ["number", "null"]},
          "weight_lb_per_shipment": {"type": ["number", "null"]},
          "shipments_per_month": {"type": ["number", "null"]},
          "service_level": {"type": ["string", "null"], "enum": ["STANDARD", "EXPEDITED", "GUARANTEED", null]},
          "accessorials": {
            "type": "array",
            "description": "Accessorial CODES from accessorials.csv that apply to this lane",
            "items": {"type": "string"}
          },
          "mode_quoted": {"type": ["string", "null"], "enum": ["LTL", "FTL", null]},
          "mode_alternatives": {
            "type": "array",
            "description": "Required when the shipment crosses an FTL threshold. The mode you did not quote, priced.",
            "items": {
              "type": "object",
              "properties": {
                "mode": {"type": "string", "enum": ["LTL", "FTL"]},
                "shipment_total": {"type": "number"},
                "monthly_total": {"type": "number"},
                "transit_days": {"type": "number"}
              }
            }
          },
          "transit_days": {"type": ["number", "null"]},
          "rationale": {"type": ["string", "null"], "description": "One sentence: why this mode and service level"},
          "pricing": {
            "type": ["object", "null"],
            "description": "Must be null on unserviceable lanes. Never quote freight you cannot move.",
            "properties": {
              "linehaul": {"type": "number"},
              "fuel_surcharge": {"type": "number"},
              "accessorials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {"type": "string"},
                    "amount": {"type": "number"}
                  }
                }
              },
              "accessorials_total": {"type": "number"},
              "shipment_subtotal": {"type": "number"},
              "discount_pct": {"type": "number"},
              "discount": {"type": "number"},
              "shipment_total": {"type": "number"},
              "monthly_total": {"type": "number"}
            }
          }
        }
      }
    },
    "volume_tier": {
      "type": "object",
      "required": ["tier_name", "total_monthly_shipments", "discount_pct"],
      "properties": {
        "tier_name": {"type": "string"},
        "total_monthly_shipments": {
          "type": "number",
          "description": "Sum over PRICEABLE lanes only. Freight you cannot serve earns no discount."
        },
        "discount_pct": {"type": "number"}
      }
    },
    "monthly_total": {"type": "number"},
    "annual_total": {"type": "number"},
    "excluded": {
      "type": "array",
      "description": "Everything you could not price, in language the customer would accept.",
      "items": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "comparable_account": {
      "type": ["object", "null"],
      "description": "Optional. Closest match from account_history.csv and why it is relevant.",
      "properties": {
        "account_name": {"type": "string"},
        "why": {"type": "string"}
      }
    }
  }
}
