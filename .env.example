# Which provider src/llm.py uses. One of: groq, gemini, github, ollama, nvidia
MODEL_PROVIDER=groq

# Optional. Override the default model for the chosen provider.
# MODEL_NAME=llama-3.3-70b-versatile

# Set the key matching MODEL_PROVIDER. Only one is required.
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
NVIDIA_API_KEY=
# ollama needs no key, just `ollama serve` running locally
